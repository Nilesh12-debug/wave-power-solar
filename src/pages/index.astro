---
// index.astro - Wave Power Solar Storytelling Landing Page
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CalculatorSection from '../components/CalculatorSection.astro';
import ChapterProblem from '../components/ChapterProblem.astro';
import ChapterIdea from '../components/ChapterIdea.astro';
import ChapterProcess from '../components/ChapterProcess.astro';
import ChapterResult from '../components/ChapterResult.astro';
import ChapterStories from '../components/ChapterStories.astro';
import ChapterClosing from '../components/ChapterClosing.astro';
---

<Base
  title="Wave Power Solar | Varanasi Rooftop Solar & PM Surya Ghar Subsidy"
  description="Stop paying soaring electricity bills in Varanasi, Mirzapur & Prayagraj. Get direct ₹78,000 PM Surya Ghar subsidy, Tier-1 solar panels, and 25-year performance warranty with Wave Power Solar."
>
  <!-- Hero Section: Pure 100vh First Screen (Broad Background + Left-Side Content Only) -->
  <Hero />

  <!-- Quotation Form & Solar Calculator: Appears seamlessly when scrolling down -->
  <CalculatorSection />

  <!-- Chapter 1: The Problem (Rising bills every summer) -->
  <ChapterProblem />

  <!-- Chapter 2: The Idea (The sun was here the whole time - dawn gradient pivot) -->
  <ChapterIdea />

  <!-- Chapter 3: The Process (4-step sticky-scroll showcase) -->
  <ChapterProcess />

  <!-- Chapter 4: The Result (Milestones & Home vs Business paths) -->
  <ChapterResult />

  <!-- Chapter 5: Their Stories (Purvanchal customer stories & before/after bills) -->
  <ChapterStories />

  <!-- Chapter 6: Your Turn (District service matrix & booking CTA) -->
  <ChapterClosing />
</Base>
