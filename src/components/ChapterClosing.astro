---
// ChapterClosing.astro - Chapter 6: Your Turn & Regional Service Area Matrix
// Direct focus on: Varanasi, Mirzapur, Chandauli, Bhadohi, Jaunpur, Ghazipur, Prayagraj
const districts = [
  { name: "Varanasi", sub: "Sigra, Lanka, Shivpur, Ramnagar, Sarnath, Cantt", active: true },
  { name: "Mirzapur", sub: "City, Chunar, Vindhyachal, Ahraura, Lalganj", active: true },
  { name: "Chandauli", sub: "Mughalsarai (Pt. DDU), Chakia, Sakaldiha", active: true },
  { name: "Bhadohi", sub: "Gyanpur, Gopiganj, Suriyawan, Carpet Industrial Belt", active: true },
  { name: "Jaunpur", sub: "City, Shahganj, Machhlishahr, Badlapur, Kerakat", active: true },
  { name: "Ghazipur", sub: "City, Saidpur, Zamania, Mohammadabad", active: true },
  { name: "Prayagraj", sub: "Civil Lines, Naini, George Town, Phaphamau, Jhunsi", active: true },
  { name: "Nearby Tehsils", sub: "Within 100km radius of Varanasi with daily van dispatch", active: true }
];
---

<section id="coverage" class="py-24 md:py-32 bg-[#0F2540] text-white relative overflow-hidden">
  
  <!-- Varanasi Ganga Ghats Aerial Local Context Background -->
  <div class="absolute inset-0 pointer-events-none z-0">
    <img
      src="https://images.unsplash.com/photo-1561361513-2d000a50f0dc?auto=format&fit=crop&w=1600&q=80"
      alt="Aerial view of Varanasi Ganga riverfront and city expanse"
      class="w-full h-full object-cover opacity-15 mix-blend-luminosity"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0F2540] via-[#0F2540]/90 to-[#0F2540]"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Chapter Tag -->
    <div class="max-w-3xl mb-16 reveal-fade">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 text-xs font-bold uppercase tracking-widest text-[#EA6B1F] mb-4">
        <span>Chapter 06</span>
        <span>•</span>
        <span>Your Turn</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif font-medium text-white leading-tight">
        Born in Varanasi. Serving all of Eastern UP.
      </h2>
      <p class="text-base sm:text-lg text-white/80 mt-4 leading-relaxed font-light">
        We don't operate out of a call center 1,000 km away. Our technicians live in your neighbourhood. When you call, a real local engineer answers the phone, and our survey van can be at your gate the next morning.
      </p>
    </div>

    <!-- District Badges Matrix -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-20 reveal-fade">
      {districts.map((dist) => (
        <div class="p-5 rounded-xl bg-[#173257]/80 border border-white/10 hover:border-[#EA6B1F]/50 transition-all backdrop-blur-sm group card-glow">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-base font-bold text-white group-hover:text-[#EA6B1F] transition-colors">{dist.name}</h3>
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          </div>
          <p class="text-xs text-white/70 leading-relaxed">{dist.sub}</p>
          <div class="mt-3 text-[11px] text-[#F98A3D] font-medium flex items-center gap-1">
            <span>Free On-Site Visit Available</span>
            <span>→</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Final Call to Action Card -->
    <div class="rounded-3xl bg-gradient-to-r from-[#EA6B1F] via-[#F98A3D] to-[#EA6B1F] p-8 sm:p-12 shadow-2xl text-white relative overflow-hidden reveal-fade">
      <!-- Decorative solar SVG silhouette in background -->
      <div class="absolute -right-16 -bottom-16 w-80 h-80 opacity-15 pointer-events-none">
        <svg viewBox="0 0 200 200" fill="currentColor">
          <circle cx="100" cy="100" r="40" />
          <path d="M100 20v20M100 160v20M20 100h20M160 100h20M43 43l14 14M143 143l14 14M43 157l14-14M143 57l14-14" stroke="currentColor" stroke-width="8" stroke-linecap="round"/>
        </svg>
      </div>

      <div class="max-w-2xl relative z-10 space-y-4">
        <span class="px-3 py-1 bg-white/20 backdrop-blur-md rounded-full text-xs font-bold uppercase tracking-wider text-white">
          No Sales Pressure • 100% Free
        </span>
        <h3 class="text-3xl sm:text-4xl md:text-5xl font-serif font-bold text-white leading-tight">
          Ready to see what solar can do for your roof?
        </h3>
        <p class="text-base sm:text-lg text-white/95 leading-relaxed font-light">
          Book a 20-minute roof inspection with a Wave Power engineer. We will check your terrace sunlight, calculate your exact PM Surya Ghar subsidy, and show you your future ₹0 bill.
        </p>

        <div class="pt-4 flex flex-col sm:flex-row gap-4">
          <a
            href="#quote-form"
            class="btn-shimmer inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-bold text-[#0F2540] bg-white hover:bg-[#F7F5F0] shadow-xl hover:shadow-2xl transition-all transform hover:-translate-y-0.5 active:translate-y-0"
          >
            Book Free Rooftop Inspection
          </a>
          <a
            href="tel:+919415012345"
            class="inline-flex items-center justify-center px-6 py-4 rounded-xl text-base font-semibold text-white bg-black/20 hover:bg-black/30 border border-white/20 backdrop-blur-sm transition-all"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            Speak to a Varanasi Engineer
          </a>
        </div>
      </div>
    </div>

  </div>
</section>
