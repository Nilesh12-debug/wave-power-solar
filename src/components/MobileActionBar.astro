---
// MobileActionBar.astro - High-conversion sticky mobile bottom action bar
---

<div
  id="mobile-bottom-bar"
  class="lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-[#0F2540]/95 backdrop-blur-lg border-t border-white/15 px-4 pt-2.5 pb-3 shadow-2xl transition-transform duration-300 transform translate-y-0"
  style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
>
  <div class="max-w-md mx-auto flex items-center justify-between gap-3">
    <!-- Call / WhatsApp Action -->
    <a
      href="tel:+919415012345"
      class="flex-1 inline-flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl text-xs font-semibold text-white bg-white/10 hover:bg-white/15 border border-white/15 transition-colors active:scale-95"
      aria-label="Call solar engineer helpline"
    >
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <svg class="w-4 h-4 text-[#EA6B1F] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
      </svg>
      <span>Call Helpline</span>
    </a>

    <!-- Primary Calculate / Subsidy CTA -->
    <a
      href="#calculator"
      class="flex-1 btn-shimmer inline-flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl text-xs font-bold text-white bg-[#EA6B1F] hover:bg-[#F98A3D] shadow-lg shadow-[#EA6B1F]/30 transition-transform active:scale-95"
    >
      <span>Calculate Subsidy</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
      </svg>
    </a>
  </div>
</div>

<script>
  // Hide bottom bar when virtual keyboard opens or when interacting inside form inputs
  const bottomBar = document.getElementById('mobile-bottom-bar');
  const inputs = document.querySelectorAll('input, select, textarea');

  if (bottomBar) {
    inputs.forEach(input => {
      input.addEventListener('focus', () => {
        bottomBar.classList.add('translate-y-full');
      });
      input.addEventListener('blur', () => {
        bottomBar.classList.remove('translate-y-full');
      });
    });
  }
</script>
