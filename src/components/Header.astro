---
// Header.astro - Premium glassmorphic sticky header
---

<header class="fixed top-0 left-0 right-0 z-40 bg-[#0F2540]/90 backdrop-blur-md border-b border-white/10 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="#" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-[#EA6B1F] rounded-lg p-1">
      <img
        src="/logo.png"
        alt="Wave Power Solar"
        class="h-10 sm:h-12 w-auto object-contain filter drop-shadow transition-transform duration-200 group-hover:scale-105"
      />
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-8 text-sm font-medium text-white/80">
      <a href="#problem" class="relative py-1 hover:text-[#EA6B1F] transition-colors group">
        <span>The Problem</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#EA6B1F] transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href="#idea" class="relative py-1 hover:text-[#EA6B1F] transition-colors group">
        <span>The Idea</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#EA6B1F] transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href="#process" class="relative py-1 hover:text-[#EA6B1F] transition-colors group">
        <span>How It Works</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#EA6B1F] transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href="#results" class="relative py-1 hover:text-[#EA6B1F] transition-colors group">
        <span>Savings & Subsidy</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#EA6B1F] transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href="#stories" class="relative py-1 hover:text-[#EA6B1F] transition-colors group">
        <span>Local Stories</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#EA6B1F] transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href="#coverage" class="relative py-1 hover:text-[#EA6B1F] transition-colors group">
        <span>Varanasi & Beyond</span>
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#EA6B1F] transition-all duration-300 group-hover:w-full"></span>
      </a>
    </nav>

    <!-- Call hotline + Quote CTA -->
    <div class="hidden sm:flex items-center gap-4">
      <a
        href="tel:+919415012345"
        class="flex items-center gap-2 text-xs md:text-sm font-medium text-white/90 hover:text-[#EA6B1F] transition-colors px-2 py-1"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <svg class="w-4 h-4 text-[#EA6B1F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        <span>+91 94150 12345</span>
      </a>

      <a
        href="#calculator"
        class="btn-shimmer inline-flex items-center justify-center px-4 py-2.5 rounded-xl text-sm font-semibold text-white bg-[#EA6B1F] hover:bg-[#F98A3D] shadow-lg shadow-[#EA6B1F]/25 transition-all duration-200 transform hover:-translate-y-0.5 active:translate-y-0"
      >
        Free Roof Visit
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <div class="flex lg:hidden items-center gap-2">
      <a
        href="#calculator"
        class="sm:hidden px-3 py-1.5 rounded-md text-xs font-semibold text-white bg-[#EA6B1F]"
      >
        Free Quote
      </a>
      <button
        id="mobile-nav-toggle"
        type="button"
        class="p-2 rounded-lg text-white/80 hover:text-white hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-[#EA6B1F]"
        aria-label="Open Navigation Menu"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-white/10 bg-[#0F2540] px-4 pt-3 pb-6 space-y-3">
    <a href="#problem" class="block text-base font-medium text-white/80 hover:text-[#EA6B1F] py-2 border-b border-white/5">The Problem</a>
    <a href="#idea" class="block text-base font-medium text-white/80 hover:text-[#EA6B1F] py-2 border-b border-white/5">The Idea</a>
    <a href="#process" class="block text-base font-medium text-white/80 hover:text-[#EA6B1F] py-2 border-b border-white/5">How It Works</a>
    <a href="#results" class="block text-base font-medium text-white/80 hover:text-[#EA6B1F] py-2 border-b border-white/5">Savings & Subsidy</a>
    <a href="#stories" class="block text-base font-medium text-white/80 hover:text-[#EA6B1F] py-2 border-b border-white/5">Local Stories</a>
    <a href="#coverage" class="block text-base font-medium text-white/80 hover:text-[#EA6B1F] py-2 border-b border-white/5">Varanasi & Coverage</a>
    
    <div class="pt-2 flex flex-col gap-3">
      <a href="tel:+919415012345" class="touch-press flex items-center justify-center gap-2 py-2.5 text-sm text-white/90 bg-white/5 rounded-lg active:scale-95 transition-transform">
        <svg class="w-4 h-4 text-[#EA6B1F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        <span>Call: +91 94150 12345</span>
      </a>
      <a href="#calculator" class="btn-shimmer btn-shimmer-continuous touch-press w-full text-center py-3 rounded-lg text-sm font-semibold text-white bg-[#EA6B1F] active:scale-95 shadow-lg shadow-[#EA6B1F]/30">
        Book Free Roof Visit
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggleBtn && menu && hamburger && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      hamburger.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    // Close when clicking nav links
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        hamburger.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
