    <!-- 4 Key Stat Metric Cards with 21st.dev Spotlight & Animated Counting Numbers -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6 mb-16 sm:mb-20 reveal-fade">
      
      <div class="p-4 sm:p-8 rounded-xl sm:rounded-2xl bg-[#173257]/80 border border-white/10 backdrop-blur-sm text-center transform hover:-translate-y-1 transition-all card-glow spotlight-card">
        <div class="text-2xl sm:text-5xl font-serif font-bold text-[#EA6B1F] mb-1 sm:mb-2" data-counter-target="5000" data-counter-suffix="+">
          5,000+
        </div>
        <div class="text-xs sm:text-sm font-semibold text-white">Happy Roofs Powered</div>
        <div class="text-[10px] sm:text-xs text-white/60 mt-0.5 sm:mt-1">Across 7 UP districts</div>
      </div>

      <div class="p-4 sm:p-8 rounded-xl sm:rounded-2xl bg-[#173257]/80 border border-white/10 backdrop-blur-sm text-center transform hover:-translate-y-1 transition-all card-glow spotlight-card">
        <div class="text-2xl sm:text-5xl font-serif font-bold text-white mb-1 sm:mb-2" data-counter-target="50" data-counter-suffix="+ MW">
          50+ MW
        </div>
        <div class="text-xs sm:text-sm font-semibold text-white">Clean Capacity</div>
        <div class="text-[10px] sm:text-xs text-white/60 mt-0.5 sm:mt-1">2.2 lakh units/day</div>
      </div>

      <div class="p-4 sm:p-8 rounded-xl sm:rounded-2xl bg-[#173257]/80 border border-white/10 backdrop-blur-sm text-center transform hover:-translate-y-1 transition-all card-glow spotlight-card">
        <div class="text-2xl sm:text-5xl font-serif font-bold text-[#3E7CC9] mb-1 sm:mb-2" data-counter-target="25" data-counter-suffix=" Yrs">
          25 Yrs
        </div>
        <div class="text-xs sm:text-sm font-semibold text-white">Generation Guarantee</div>
        <div class="text-[10px] sm:text-xs text-white/60 mt-0.5 sm:mt-1">Tier-1 linear warranty</div>
      </div>

      <div class="p-4 sm:p-8 rounded-xl sm:rounded-2xl bg-[#173257]/80 border border-white/10 backdrop-blur-sm text-center transform hover:-translate-y-1 transition-all card-glow spotlight-card">
        <div class="text-2xl sm:text-5xl font-serif font-bold text-emerald-400 mb-1 sm:mb-2" data-counter-target="4.8" data-counter-float="true" data-counter-suffix=" / 5">
