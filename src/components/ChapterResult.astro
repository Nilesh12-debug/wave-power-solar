    </div>

    <!-- The Two Paths: Residential vs Commercial -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 reveal-fade">
      
      <!-- Path 1: For Your Home -->
      <div class="bg-gradient-to-b from-[#173257] to-[#0F2540] rounded-2xl overflow-hidden border border-white/15 flex flex-col hover:border-[#EA6B1F]/60 transition-all duration-300 card-glow">
