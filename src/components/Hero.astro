---
// Hero.astro - Full-screen 21st.dev inspired hero with lady solar engineer visible on right, scroll parallax & hover effects
---

<section class="relative min-h-screen pt-24 pb-16 md:pt-32 md:pb-24 overflow-hidden bg-[#0F2540] text-white flex items-center">
  <!-- Full Screen Background Image: Lady Solar Engineer visible on the Right -->
  <div id="hero-bg-container" class="absolute inset-0 z-0 pointer-events-none transition-transform duration-100 ease-out">
    <img
      id="hero-bg-img"
      src="/hero-solar-engineer.jpg"
      alt="Wave Power Solar lead engineer standing on rooftop beside solar panel arrays at golden sunset"
      class="w-full h-full object-cover object-[78%_center] sm:object-[82%_center] lg:object-right filter brightness-[0.92] contrast-[1.05]"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Directional Vignette: Left side dark for typography contrast, right side transparent for lady engineer & solar panels -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#0F2540]/95 via-[#0F2540]/80 md:via-[#0F2540]/45 to-transparent"></div>
    <!-- Top & bottom subtle transitions -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#0F2540]/80 via-transparent to-[#0F2540]"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Story Headline, Narrative & Interactive 21st.dev Calculator Card -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- 21st.dev Style Glowing Pill Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs sm:text-sm text-white backdrop-blur-md shadow-lg card-glow">
          <span class="w-2.5 h-2.5 rounded-full bg-[#EA6B1F] animate-pulse"></span>
          <span class="font-medium">Varanasi's Leading Rooftop Solar Partner</span>
          <span class="text-white/40">•</span>
          <span class="text-[#F98A3D] font-semibold">PM Surya Ghar Authorized</span>
        </div>

        <!-- Main Narrative Headline -->
        <h1 class="text-3xl sm:text-5xl xl:text-6xl font-serif font-medium leading-[1.12] tracking-tight text-white drop-shadow-md">
          Stop paying for electricity when the sun shines on your roof <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#EA6B1F] via-[#F98A3D] to-amber-200 italic">every single day.</span>
        </h1>

        <!-- Plain English Narrative Copy -->
        <p class="text-base sm:text-lg text-white/90 leading-relaxed max-w-2xl font-light drop-shadow">
          Your power bill climbs higher every summer across Varanasi and Purvanchal. With Wave Power Solar, you generate your own clean power, claim up to <strong class="font-semibold text-white underline decoration-[#EA6B1F] decoration-2 underline-offset-4">₹78,000 direct government subsidy</strong>, and bring your electricity bills close to zero.
        </p>

        <!-- 21st.dev Inspired Interactive Calculator Card -->
        <div id="quote-form" class="p-5 sm:p-6 rounded-2xl bg-[#0F2540]/80 backdrop-blur-xl border border-white/20 shadow-2xl card-glow max-w-xl space-y-4">
          
          <div class="flex items-center justify-between pb-3 border-b border-white/15">
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#EA6B1F]">Interactive Savings Estimator</span>
              <h2 class="text-lg sm:text-xl font-serif font-bold text-white">See Your Rooftop Return</h2>
            </div>
            <span class="px-2.5 py-1 bg-emerald-500/20 text-emerald-300 font-semibold text-xs rounded-full border border-emerald-500/30">
              Free Roof Audit
            </span>
          </div>

          <!-- Bill Slider -->
          <div>
            <div class="flex justify-between items-baseline mb-2">
              <label for="monthly-bill-slider" class="text-xs sm:text-sm font-medium text-white/80">
                Average Monthly Electricity Bill
              </label>
              <span id="bill-display" class="text-base sm:text-lg font-bold text-[#F98A3D] font-serif">
                ₹5,000 / month
              </span>
            </div>
            <input
              id="monthly-bill-slider"
              type="range"
              min="1500"
              max="25000"
              step="500"
              value="5000"
              class="w-full h-2 bg-white/20 rounded-lg appearance-none cursor-pointer accent-[#EA6B1F] focus:outline-none focus:ring-2 focus:ring-[#EA6B1F]"
            />
            <div class="flex justify-between text-[11px] text-white/60 mt-1 font-mono">
              <span>₹1,500</span>
              <span>₹10,000</span>
              <span>₹25,000+</span>
            </div>
          </div>

          <!-- Calculated Metrics -->
          <div class="grid grid-cols-2 gap-3 p-3 bg-white/5 rounded-xl border border-white/10">
            <div>
              <span class="text-[10px] uppercase tracking-wide text-white/60 block font-semibold">Recommended Plant</span>
              <span id="calc-kw" class="text-base font-bold text-white font-serif">3 kW Plant</span>
            </div>
            <div>
              <span class="text-[10px] uppercase tracking-wide text-white/60 block font-semibold">Yearly Savings</span>
              <span id="calc-savings" class="text-base font-bold text-emerald-400 font-serif">₹54,000 / yr</span>
            </div>
            <div class="col-span-2 pt-2 border-t border-white/10 flex justify-between items-center text-xs">
              <span class="text-white/70">Govt. Direct Subsidy:</span>
              <span id="calc-subsidy" class="font-bold text-[#EA6B1F] bg-orange-500/10 px-2 py-0.5 rounded border border-[#EA6B1F]/30">
                ₹78,000 Direct
              </span>
            </div>
          </div>

          <!-- Fast Lead Input -->
          <form id="hero-lead-form" class="space-y-3 pt-1">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <input
                id="lead-phone"
                type="tel"
                required
                pattern="[0-9]{10}"
                placeholder="10-digit WhatsApp/Phone"
                class="w-full px-3.5 py-2.5 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/50 text-sm focus:border-[#EA6B1F] focus:bg-white/15 focus:ring-1 focus:ring-[#EA6B1F] transition-all"
              />
              <select
                id="lead-city"
                class="w-full px-3 py-2.5 rounded-xl bg-[#0F2540] border border-white/20 text-white text-sm focus:border-[#EA6B1F] focus:ring-1 focus:ring-[#EA6B1F] transition-all"
              >
                <option value="Varanasi">Varanasi</option>
                <option value="Mirzapur">Mirzapur</option>
                <option value="Chandauli">Chandauli</option>
                <option value="Bhadohi">Bhadohi</option>
                <option value="Jaunpur">Jaunpur</option>
                <option value="Ghazipur">Ghazipur</option>
                <option value="Prayagraj">Prayagraj</option>
                <option value="Other">Other nearby</option>
              </select>
            </div>

            <button
              type="submit"
              class="w-full py-3 px-4 rounded-xl text-white font-semibold text-sm sm:text-base bg-[#EA6B1F] hover:bg-[#F98A3D] shadow-lg shadow-[#EA6B1F]/30 transition-all duration-200 transform hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2 btn-shimmer"
            >
              <span>Book Free Roof Visit & Exact Quote</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>

            <!-- Success message -->
            <div id="form-success-msg" class="hidden p-2.5 bg-emerald-500/20 border border-emerald-500/40 rounded-lg text-emerald-300 text-xs text-center font-medium">
              ✅ Thank you! Our Varanasi solar engineer will call you shortly to arrange your free roof audit.
            </div>
          </form>

        </div>

        <!-- Social Proof snippet with micro hover -->
        <div class="flex items-center gap-4 pt-1">
          <div class="flex -space-x-2 overflow-hidden">
            <img class="inline-block h-9 w-9 rounded-full ring-2 ring-[#0F2540] object-cover" src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=120&q=80" alt="Customer avatar" />
            <img class="inline-block h-9 w-9 rounded-full ring-2 ring-[#0F2540] object-cover" src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=120&q=80" alt="Customer avatar" />
            <img class="inline-block h-9 w-9 rounded-full ring-2 ring-[#0F2540] object-cover" src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=120&q=80" alt="Customer avatar" />
          </div>
          <div class="text-xs sm:text-sm text-white/90 drop-shadow">
            <span class="text-[#F98A3D] font-bold">★★★★★ 4.8/5</span> from 5,000+ happy roofs across Varanasi, Mirzapur & Prayagraj
          </div>
        </div>

      </div>

      <!-- Right Column: The Lady Solar Engineer is Celebrated with 21st.dev Floating Badges -->
      <div class="lg:col-span-5 relative h-full flex flex-col justify-between items-end min-h-[300px] lg:min-h-[500px] pointer-events-none">
        
        <!-- Top Floating Parallax Badge -->
        <div class="pointer-events-auto animate-float self-end mr-4 lg:mr-0 p-3.5 rounded-2xl bg-[#0F2540]/80 backdrop-blur-xl border border-white/20 text-white shadow-2xl card-glow flex items-center gap-3 transform hover:scale-105 transition-transform">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/20 border border-emerald-400/40 flex items-center justify-center text-emerald-400 font-bold text-lg">
            ⚡
          </div>
          <div>
            <span class="text-[10px] uppercase font-bold tracking-wider text-emerald-400 block">Live Generation</span>
            <span class="text-sm font-bold text-white">4.8 kW Rooftop Plant</span>
          </div>
        </div>

        <!-- Center/Bottom Floating Parallax Engineer Badge -->
        <div class="pointer-events-auto animate-float-delayed self-start lg:self-end mt-24 lg:mt-48 p-4 rounded-2xl bg-[#0F2540]/85 backdrop-blur-xl border border-[#EA6B1F]/40 text-white shadow-2xl card-glow max-w-xs transform hover:scale-105 transition-transform">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-[#EA6B1F] flex items-center justify-center text-white font-bold text-sm shadow">
              ✓
            </div>
            <div>
              <span class="text-xs font-bold text-white block">Varanasi Technical Team</span>
              <p class="text-[11px] text-white/70">Certified 3D Roof Survey & Net-Metering</p>
            </div>
          </div>
          <div class="mt-2.5 pt-2 border-t border-white/10 flex items-center justify-between text-[11px]">
            <span class="text-[#F98A3D] font-medium">● Survey Van Available</span>
            <span class="text-white/60">25-Yr Guarantee</span>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  // 21st.dev Style Scroll Parallax Effect
  const bgImg = document.getElementById('hero-bg-img');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (bgImg && !prefersReducedMotion) {
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          if (scrollY < 1000) {
            bgImg.style.transform = `translateY(${scrollY * 0.18}px) scale(${1 + scrollY * 0.0002})`;
          }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }

  // Interactive Quote Calculator
  const billSlider = document.getElementById('monthly-bill-slider') as HTMLInputElement | null;
  const billDisplay = document.getElementById('bill-display');
  const calcKw = document.getElementById('calc-kw');
  const calcSavings = document.getElementById('calc-savings');
  const calcSubsidy = document.getElementById('calc-subsidy');
  const leadForm = document.getElementById('hero-lead-form');
  const successMsg = document.getElementById('form-success-msg');

  if (billSlider && billDisplay && calcKw && calcSavings && calcSubsidy) {
    function updateCalculator(val: number) {
      billDisplay.textContent = `₹${val.toLocaleString('en-IN')} / month`;
      
      let kw = 2;
      let subsidy = '₹60,000 Direct';
      if (val < 2500) {
        kw = 1;
        subsidy = '₹30,000 Direct';
      } else if (val <= 4500) {
        kw = 2;
        subsidy = '₹60,000 Direct';
      } else if (val <= 8500) {
        kw = 3;
        subsidy = '₹78,000 Direct';
      } else if (val <= 14000) {
        kw = 5;
        subsidy = '₹78,000 (Max Cap)';
      } else {
        kw = Math.min(15, Math.round(val / 2200));
        subsidy = '₹78,000 (Max Cap)';
      }

      calcKw.textContent = `${kw} kW Plant`;
      const yearlySavings = Math.round(val * 12 * 0.90);
      calcSavings.textContent = `₹${yearlySavings.toLocaleString('en-IN')} / yr`;
      calcSubsidy.textContent = subsidy;
    }

    billSlider.addEventListener('input', (e) => {
      const val = parseInt((e.target as HTMLInputElement).value, 10);
      updateCalculator(val);
    });

    updateCalculator(5000);
  }

  if (leadForm && successMsg) {
    leadForm.addEventListener('submit', (e) => {
      e.preventDefault();
      successMsg.classList.remove('hidden');
      (leadForm as HTMLFormElement).reset();
      setTimeout(() => {
        successMsg.classList.add('hidden');
      }, 7000);
    });
  }
</script>
