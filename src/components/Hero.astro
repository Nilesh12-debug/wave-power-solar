---
// Hero.astro - Dark navy luxury hero with subtle ambient sunburst, parallax layers, and interactive floating quote card
---

<section class="relative min-h-[92vh] pt-28 pb-16 md:pt-36 md:pb-24 overflow-hidden bg-[#0F2540] text-white flex items-center">
  <!-- Parallax Background Container -->
  <div id="hero-parallax-bg" class="absolute inset-0 pointer-events-none z-0">
    <!-- Unsplash Luxury House with Solar Panels Dusk -->
    <img
      src="https://images.unsplash.com/photo-1613665813446-82a78c468a1d?auto=format&fit=crop&w=1800&q=80"
      alt="Luxury home equipped with high efficiency solar panels at golden dusk"
      class="w-full h-full object-cover object-center opacity-30 mix-blend-luminosity scale-105"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Deep Navy to Warm Radial Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#0F2540]/80 via-[#0F2540]/90 to-[#0F2540]"></div>
    <div class="absolute -top-32 -left-32 w-[600px] h-[600px] rounded-full bg-radial from-[#EA6B1F]/20 via-[#3E7CC9]/10 to-transparent blur-3xl"></div>
    <div class="absolute top-1/2 -right-40 w-[500px] h-[500px] rounded-full bg-radial from-[#3E7CC9]/20 to-transparent blur-3xl"></div>
  </div>

  <!-- Ambient rotating Sun-ray SVG behind headline (140s slow rotation, low opacity) -->
  <div class="absolute top-12 left-1/4 -translate-x-1/2 w-[720px] h-[720px] pointer-events-none z-0 opacity-15 select-none animate-spin-slow">
    <svg viewBox="0 0 500 500" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full text-[#EA6B1F]">
      <circle cx="250" cy="250" r="110" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 8" />
      <circle cx="250" cy="250" r="180" stroke="currentColor" stroke-width="1" stroke-dasharray="6 12" />
      <g stroke="currentColor" stroke-width="1.5" opacity="0.8">
        <line x1="250" y1="20" x2="250" y2="70" />
        <line x1="250" y1="430" x2="250" y2="480" />
        <line x1="20" y1="250" x2="70" y2="250" />
        <line x1="430" y1="250" x2="480" y2="250" />
        <line x1="87" y1="87" x2="123" y2="123" />
        <line x1="377" y1="377" x2="413" y2="413" />
        <line x1="87" y1="413" x2="123" y2="377" />
        <line x1="377" y1="123" x2="413" y2="87" />
        <!-- Additional fine radial rays -->
        <line x1="250" y1="100" x2="250" y2="125" stroke-width="2"/>
        <line x1="250" y1="375" x2="250" y2="400" stroke-width="2"/>
        <line x1="100" y1="250" x2="125" y2="250" stroke-width="2"/>
        <line x1="375" y1="250" x2="400" y2="250" stroke-width="2"/>
      </g>
    </svg>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Story Headline & Trust Badges -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Location Pill -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/15 text-xs sm:text-sm text-white/90 backdrop-blur-sm shadow-sm">
          <span class="w-2 h-2 rounded-full bg-[#EA6B1F]"></span>
          <span class="font-medium">Varanasi's Trusted Rooftop Solar Partner</span>
          <span class="text-white/40">•</span>
          <span class="text-[#F98A3D] font-medium">PM Surya Ghar Authorized</span>
        </div>

        <!-- Main Narrative Headline -->
        <h1 class="text-4xl sm:text-5xl xl:text-6xl font-serif font-medium leading-[1.12] tracking-tight text-white">
          Stop paying for electricity when the sun shines on your roof <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#EA6B1F] to-[#F98A3D] italic">every single day.</span>
        </h1>

        <!-- Lead Copy: Plain, Neighbourly English -->
        <p class="text-lg sm:text-xl text-white/80 leading-relaxed max-w-2xl font-light">
          Your power bill climbs higher every summer in Varanasi and Purvanchal. With Wave Power Solar, you generate your own clean power, claim up to <strong class="font-semibold text-white">₹78,000 in direct government subsidy</strong>, and bring your electricity bills close to zero.
        </p>

        <!-- Key quick proof points -->
        <div class="grid grid-cols-3 gap-4 pt-4 border-t border-white/10 max-w-xl">
          <div>
            <div class="text-2xl sm:text-3xl font-serif font-semibold text-[#EA6B1F]">₹0</div>
            <div class="text-xs sm:text-sm text-white/70 mt-0.5">Electricity bill target for most homes</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-serif font-semibold text-white">₹78,000</div>
            <div class="text-xs sm:text-sm text-white/70 mt-0.5">Direct PM Surya Ghar subsidy</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-serif font-semibold text-[#3E7CC9]">25 Yrs</div>
            <div class="text-xs sm:text-sm text-white/70 mt-0.5">Performance guarantee on panels</div>
          </div>
        </div>

        <!-- Social Proof snippet -->
        <div class="flex items-center gap-4 pt-2">
          <div class="flex -space-x-2 overflow-hidden">
            <img class="inline-block h-9 w-9 rounded-full ring-2 ring-[#0F2540] object-cover" src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=120&q=80" alt="Customer avatar" />
            <img class="inline-block h-9 w-9 rounded-full ring-2 ring-[#0F2540] object-cover" src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=120&q=80" alt="Customer avatar" />
            <img class="inline-block h-9 w-9 rounded-full ring-2 ring-[#0F2540] object-cover" src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=120&q=80" alt="Customer avatar" />
          </div>
          <div class="text-xs text-white/80">
            <span class="text-[#F98A3D] font-bold">★★★★★ 4.8/5</span> from 5,000+ happy roofs across Varanasi, Mirzapur & Prayagraj
          </div>
        </div>
      </div>

      <!-- Right Column: Floating White Quote & Savings Estimator Card -->
      <div class="lg:col-span-5" id="quote-form">
        <div class="relative bg-white text-[#12233C] rounded-2xl p-6 sm:p-8 shadow-2xl shadow-black/40 border border-white/60">
          
          <!-- Badge -->
          <div class="flex items-center justify-between pb-4 border-b border-[#E4E2DA]">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-[#EA6B1F]">Instant Estimate</span>
              <h2 class="text-xl sm:text-2xl font-serif font-bold text-[#0F2540] mt-0.5">See Your Solar Savings</h2>
            </div>
            <span class="px-2.5 py-1 bg-emerald-100 text-emerald-800 font-semibold text-xs rounded-full">
              Free Roof Audit
            </span>
          </div>

          <!-- Dynamic Bill Slider / Selector -->
          <div class="mt-5 space-y-4">
            <div>
              <div class="flex justify-between items-baseline mb-2">
                <label for="monthly-bill-slider" class="text-xs sm:text-sm font-semibold text-[#5B6B7F]">
                  Average Monthly Electricity Bill
                </label>
                <span id="bill-display" class="text-lg sm:text-xl font-bold text-[#0F2540] font-serif">
                  ₹5,000 / month
                </span>
              </div>
              <input
                id="monthly-bill-slider"
                type="range"
                min="1500"
                max="25000"
                step="500"
                value="5000"
                class="w-full h-2.5 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-[#EA6B1F] focus:outline-none focus:ring-2 focus:ring-[#EA6B1F]"
              />
              <div class="flex justify-between text-[11px] text-[#5B6B7F] mt-1 font-mono">
                <span>₹1,500</span>
                <span>₹10,000</span>
                <span>₹25,000+</span>
              </div>
            </div>

            <!-- Calculated Metrics Box -->
            <div class="grid grid-cols-2 gap-3 p-3.5 bg-[#F7F5F0] rounded-xl border border-[#E4E2DA]">
              <div>
                <span class="text-[11px] uppercase tracking-wide text-[#5B6B7F] block">Recommended System</span>
                <span id="calc-kw" class="text-lg font-bold text-[#0F2540] font-serif">3 kW Plant</span>
              </div>
              <div>
                <span class="text-[11px] uppercase tracking-wide text-[#5B6B7F] block">Estimated Yearly Savings</span>
                <span id="calc-savings" class="text-lg font-bold text-emerald-700 font-serif">₹54,000 / yr</span>
              </div>
              <div class="col-span-2 pt-2 border-t border-[#E4E2DA]/80 flex justify-between items-center text-xs">
                <span class="text-[#5B6B7F]">Govt. Subsidy (PM Surya Ghar):</span>
                <span id="calc-subsidy" class="font-bold text-[#EA6B1F] bg-orange-50 px-2 py-0.5 rounded border border-orange-200">
                  ₹78,000 Direct
                </span>
              </div>
            </div>

            <!-- Lead Capture Inputs -->
            <form id="hero-lead-form" class="space-y-3 pt-2">
              <div>
                <label for="lead-name" class="block text-xs font-semibold text-[#5B6B7F] mb-1">Full Name</label>
                <input
                  id="lead-name"
                  type="text"
                  required
                  placeholder="e.g. Ramesh Kumar"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-[#E4E2DA] text-sm focus:border-[#EA6B1F] focus:ring-1 focus:ring-[#EA6B1F] transition-colors"
                />
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label for="lead-phone" class="block text-xs font-semibold text-[#5B6B7F] mb-1">WhatsApp / Phone</label>
                  <input
                    id="lead-phone"
                    type="tel"
                    required
                    pattern="[0-9]{10}"
                    placeholder="10-digit number"
                    class="w-full px-3.5 py-2.5 rounded-lg border border-[#E4E2DA] text-sm focus:border-[#EA6B1F] focus:ring-1 focus:ring-[#EA6B1F] transition-colors"
                  />
                </div>
                <div>
                  <label for="lead-city" class="block text-xs font-semibold text-[#5B6B7F] mb-1">District / City</label>
                  <select
                    id="lead-city"
                    class="w-full px-3 py-2.5 rounded-lg border border-[#E4E2DA] text-sm bg-white focus:border-[#EA6B1F] focus:ring-1 focus:ring-[#EA6B1F] transition-colors"
                  >
                    <option value="Varanasi">Varanasi</option>
                    <option value="Mirzapur">Mirzapur</option>
                    <option value="Chandauli">Chandauli</option>
                    <option value="Bhadohi">Bhadohi</option>
                    <option value="Jaunpur">Jaunpur</option>
                    <option value="Ghazipur">Ghazipur</option>
                    <option value="Prayagraj">Prayagraj</option>
                    <option value="Other">Other nearby</option>
                  </select>
                </div>
              </div>

              <button
                type="submit"
                id="submit-quote-btn"
                class="w-full py-3.5 px-4 rounded-xl text-white font-semibold text-sm sm:text-base bg-[#EA6B1F] hover:bg-[#F98A3D] shadow-lg shadow-[#EA6B1F]/30 transition-all duration-200 transform hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2"
              >
                <span>Book Free Rooftop Survey & Quote</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </button>

              <p class="text-[11px] text-center text-[#5B6B7F] mt-1">
                🔒 No spam. Our local Varanasi solar engineer will call within 2 hours.
              </p>

              <!-- Form Success Feedback -->
              <div id="form-success-msg" class="hidden p-3 bg-emerald-50 border border-emerald-200 rounded-lg text-emerald-800 text-xs text-center font-medium">
                ✅ Thank you! Our solar engineer will contact you shortly to schedule your free roof visit.
              </div>
            </form>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Parallax Scroll Effect
  const parallaxBg = document.getElementById('hero-parallax-bg');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (parallaxBg && !prefersReducedMotion) {
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          if (scrollY < 900) {
            parallaxBg.style.transform = `translateY(${scrollY * 0.22}px)`;
          }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }

  // Interactive Quote Calculator
  const billSlider = document.getElementById('monthly-bill-slider') as HTMLInputElement | null;
  const billDisplay = document.getElementById('bill-display');
  const calcKw = document.getElementById('calc-kw');
  const calcSavings = document.getElementById('calc-savings');
  const calcSubsidy = document.getElementById('calc-subsidy');
  const leadForm = document.getElementById('hero-lead-form');
  const successMsg = document.getElementById('form-success-msg');

  if (billSlider && billDisplay && calcKw && calcSavings && calcSubsidy) {
    function updateCalculator(val: number) {
      billDisplay.textContent = `₹${val.toLocaleString('en-IN')} / month`;
      
      let kw = 2;
      let subsidy = '₹60,000 Direct';
      if (val < 2500) {
        kw = 1;
        subsidy = '₹30,000 Direct';
      } else if (val <= 4500) {
        kw = 2;
        subsidy = '₹60,000 Direct';
      } else if (val <= 8500) {
        kw = 3;
        subsidy = '₹78,000 Direct';
      } else if (val <= 14000) {
        kw = 5;
        subsidy = '₹78,000 (Max Cap)';
      } else {
        kw = Math.min(15, Math.round(val / 2200));
        subsidy = '₹78,000 (Max Cap)';
      }

      calcKw.textContent = `${kw} kW Plant`;
      // Estimated 90% savings
      const yearlySavings = Math.round(val * 12 * 0.90);
      calcSavings.textContent = `₹${yearlySavings.toLocaleString('en-IN')} / yr`;
      calcSubsidy.textContent = subsidy;
    }

    billSlider.addEventListener('input', (e) => {
      const val = parseInt((e.target as HTMLInputElement).value, 10);
      updateCalculator(val);
    });

    // Initial setup
    updateCalculator(5000);
  }

  // Form submission handler
  if (leadForm && successMsg) {
    leadForm.addEventListener('submit', (e) => {
      e.preventDefault();
      successMsg.classList.remove('hidden');
      (leadForm as HTMLFormElement).reset();
      setTimeout(() => {
        successMsg.classList.add('hidden');
      }, 7000);
    });
  }
</script>
