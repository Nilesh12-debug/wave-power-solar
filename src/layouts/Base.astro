---
// Base.astro - Root layout for Wave Power Solar
import Preloader from '../components/Preloader.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Wave Power Solar | Varanasi's Trusted Rooftop Solar Experts",
  description = "Cut your electricity bills to ₹0 with Wave Power Solar in Varanasi, Mirzapur, Bhadohi, and Prayagraj. PM Surya Ghar direct subsidy up to ₹78,000, 25-year warranty, and hassle-free net metering."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Solar panel Varanasi, PM Surya Ghar Varanasi, rooftop solar Purvanchal, solar subsidy UP, Mirzapur solar, Prayagraj solar panels, Wave Power Solar" />
    <meta name="theme-color" content="#0F2540" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/logo.png" />

    <!-- Google Fonts: Fraunces (Headings) + Inter (Body/UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-[#F7F5F0] text-[#12233C] font-sans antialiased selection:bg-[#EA6B1F] selection:text-white pb-14 lg:pb-0">
    <!-- Top Scroll Progress Indicator (21st.dev style subtle indicator) -->
    <div
      id="scroll-progress-bar"
      class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-[#EA6B1F] via-[#F98A3D] to-[#3E7CC9] z-50 transition-[width] duration-75 ease-out pointer-events-none"
      style="width: 0%"
      aria-hidden="true"
    ></div>

    <!-- Full-screen Preloader -->
    <Preloader />

    <!-- Sticky Navigation Header -->
    <Header />

    <!-- Main Content Container -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer />

    <!-- Mobile Sticky Floating Action Bar -->
    <MobileActionBar />

    <!-- 21st.dev Interactive Engine: Spotlight, 3D Tilt, Parallax, Reveal & Number Counters -->
    <script>
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Scroll Progress Bar
      const progressBar = document.getElementById('scroll-progress-bar');
      if (progressBar) {
        window.addEventListener('scroll', () => {
          const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
          if (totalHeight > 0) {
            const progress = (window.scrollY / totalHeight) * 100;
            progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
          }
        }, { passive: true });
      }

      // 2. Reveal-Fade, Slide-Up, Scale & Bar-Grow Intersection Observer
      if ('IntersectionObserver' in window) {
        // Mobile-tuned threshold and margin
        const isMobile = window.innerWidth < 768;
        const revealObserver = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              obs.unobserve(entry.target);
            }
          });
        }, {
          threshold: isMobile ? 0.05 : 0.1,
          rootMargin: isMobile ? '0px 0px -15px 0px' : '0px 0px -35px 0px'
        });

        document.querySelectorAll('.reveal-fade, .reveal-slide-up, .reveal-scale, .bar-grow').forEach(el => {
          revealObserver.observe(el);
        });
      } else {
        document.querySelectorAll('.reveal-fade, .reveal-slide-up, .reveal-scale, .bar-grow').forEach(el => {
          el.classList.add('is-revealed');
        });
      }

      // 3. 21st.dev Mouse & Touch Spotlight Effect
      // Mouse tracking
      document.querySelectorAll('.spotlight-card').forEach(card => {
        const el = card as HTMLElement;
        el.addEventListener('mousemove', (e: MouseEvent) => {
          const rect = el.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          el.style.setProperty('--mouse-x', `${x}px`);
          el.style.setProperty('--mouse-y', `${y}px`);
        });

        // Touch tracking for mobile
        el.addEventListener('touchmove', (e: TouchEvent) => {
          if (e.touches.length > 0) {
            const rect = el.getBoundingClientRect();
            const x = e.touches[0].clientX - rect.left;
            const y = e.touches[0].clientY - rect.top;
            el.style.setProperty('--mouse-x', `${x}px`);
            el.style.setProperty('--mouse-y', `${y}px`);
          }
        }, { passive: true });
      });

      // 3D Tilt for desktop
      if (window.innerWidth >= 1024) {
        document.querySelectorAll('.tilt-card').forEach(el => {
          const card = el as HTMLElement;
          card.addEventListener('mousemove', (e: MouseEvent) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            const rotateX = ((y - centerY) / centerY) * -6;
            const rotateY = ((x - centerX) / centerX) * 6;

            card.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) translateY(-4px)`;
          });

          card.addEventListener('mouseleave', () => {
            card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0px)';
          });
        });
      }

      // 4. 21st.dev Animated Number Counters
      function animateCounter(el: HTMLElement) {
        const target = parseFloat(el.getAttribute('data-counter-target') || '0');
        const prefix = el.getAttribute('data-counter-prefix') || '';
        const suffix = el.getAttribute('data-counter-suffix') || '';
        const isFloat = el.getAttribute('data-counter-float') === 'true';
        const duration = 1400; // ms
        const startTime = performance.now();

        function update(currentTime: number) {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);
          // Ease-out cubic
          const easeOut = 1 - Math.pow(1 - progress, 3);
          const currentVal = target * easeOut;

          el.textContent = isFloat
            ? `${prefix}${currentVal.toFixed(1)}${suffix}`
            : `${prefix}${Math.round(currentVal).toLocaleString('en-IN')}${suffix}`;

          if (progress < 1) {
            requestAnimationFrame(update);
          } else {
            el.textContent = isFloat
              ? `${prefix}${target.toFixed(1)}${suffix}`
              : `${prefix}${target.toLocaleString('en-IN')}${suffix}`;
          }
        }

        requestAnimationFrame(update);
      }

      if ('IntersectionObserver' in window) {
        const counterObserver = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              animateCounter(entry.target as HTMLElement);
              obs.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08 });

        document.querySelectorAll('[data-counter-target]').forEach(el => {
          counterObserver.observe(el);
        });
      } else {
        document.querySelectorAll('[data-counter-target]').forEach(el => {
          const target = el.getAttribute('data-counter-target') || '';
          const prefix = el.getAttribute('data-counter-prefix') || '';
          const suffix = el.getAttribute('data-counter-suffix') || '';
          el.textContent = `${prefix}${target}${suffix}`;
        });
      }

      // 5. Viewport-Relative Parallax Engine
      if (!prefersReducedMotion) {
        let ticking = false;
        const parallaxElements = document.querySelectorAll('[data-parallax-speed]');

        function onScrollParallax() {
          const windowHeight = window.innerHeight;
          const scrollY = window.scrollY;

          // Hero background parallax
          const heroBg = document.getElementById('hero-bg-img');
          if (heroBg && scrollY < windowHeight * 1.5) {
            heroBg.style.transform = `translateY(${(scrollY * 0.22).toFixed(1)}px) scale(1.05)`;
          }

          // Section relative parallax elements
          parallaxElements.forEach(el => {
            const element = el as HTMLElement;
            const rect = element.getBoundingClientRect();
            // Check if element is anywhere near visible viewport
            if (rect.bottom >= -100 && rect.top <= windowHeight + 100) {
              const speed = parseFloat(element.getAttribute('data-parallax-speed') || '0.1');
              const offsetFromCenter = rect.top + rect.height / 2 - windowHeight / 2;
              const yOffset = -(offsetFromCenter * speed);
              element.style.transform = `translateY(${yOffset.toFixed(1)}px)`;
            }
          });

          ticking = false;
        }

        window.addEventListener('scroll', () => {
          if (!ticking) {
            window.requestAnimationFrame(onScrollParallax);
            ticking = true;
          }
        }, { passive: true });
        
        // Initial run
        onScrollParallax();
      }
    </script>
  </body>
</html>
